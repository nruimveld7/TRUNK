# Runtime
NODE_ENV=development
ORIGIN=http://localhost
HOST=0.0.0.0
PORT=3000
# Container process UID/GID. StartProd.sh supplies the invoking account automatically.
TRUNK_UID=1000
TRUNK_GID=1000

# Site branding. TRUNK remains the product name; these label each deployment.
TRUNK_SITE_NAME=Operations
TRUNK_SITE_DESCRIPTION=Central launcher for tools and applications
TRUNK_ACCENT_COLOR=#2563eb

# Authentication: mock is development-only; use entra in production.
AUTH_MODE=mock
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Preferred production credential: mount a certificate/key pair read-only.
ENTRA_CLIENT_CERT_PRIVATE_KEY_PATH=/app/certs/entra-client.key
ENTRA_CLIENT_CERT_PUBLIC_CERT_PATH=/app/certs/entra-client.crt
ENTRA_REDIRECT_URI=http://localhost/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost/
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
BOOTSTRAP_MAINTAINER_OIDS=

# Optional unauthenticated corporate SMTP relay (port 25).
SMTP_RELAY_HOST=
SMTP_MAIL_FROM=
# Development/testing only: redirect all access notifications.
EMAIL_RECIPIENT_OVERRIDE=

# Storage and registry
DATABASE_PATH=./data/trunk.db
APPLICATION_REGISTRY_PATH=./config/applications.yaml
ENABLE_DEMO_APPS=true

# Monitoring
HEALTH_DEFAULT_INTERVAL_SECONDS=30
HEALTH_TIMEOUT_MS=5000

# Caddy. Use :80 for local HTTP; replace with the approved FQDN for production.
TRUNK_HOSTNAME=:80

# Optional corporate TLS inspection CA used only as a Docker build secret.
CORPORATE_CA_CERT_PATH=/usr/local/share/ca-certificates/corporate-ca.crt
